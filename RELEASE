 - Build kvm RPM
        ssh root@fudu "cd /usr/local/webadmin ; ./makemodulerpm.pl --sign --dir server-manager server-manager-kvm"

 - Upload kvm RPM
        scp /usr/src/redhat/RPMS/noarch/wbm-server-manager-$ver.kvm-1.noarch.rpm virtualmin@virtualmin.com:domains/vm2.virtualmin.com/public_html/kvm/universal/
        ssh virtualmin@virtualmin.com "cd domains/vm2.virtualmin.com/public_html/kvm/universal ; createrepo -s sha ."

 - Build kvm tar.gz
	./create-module.pl --dir server-manager --sign virtualmin/server-manager-$ver.kvm.wbm.gz server-manager-kvm

 - Upload kvm tar.gz
	scp virtualmin/server-manager-$ver.kvm.wbm.gz* virtualmin@virtualmin.com:domains/vm2.virtualmin.com/public_html/kvm/wbm/

 - Fix updates.txt
        ssh virtualmin@virtualmin.com
        vi domains/vm2.virtualmin.com/public_html/kvm/wbm/updates.txt

 - Build kvm DEB
	ssh lentor "cd /usr/local/webadmin ; ./makemoduledeb.pl --dir server-manager server-manager-kvm ; cp /tmp/webmin-server-manager_${ver}.kvm_all.deb /usr/local/download/deb/cloudmin-kvm/binary"

 - Build APT repository
	ssh lentor "cd /usr/local/download/deb/cloudmin-kvm ; ./make-repo.sh"
	( cd /usr/local/download/deb/cloudmin-kvm ; rsync --rsh=ssh -r -v * virtualmin@virtualmin.com:domains/vm2.virtualmin.com/public_html/kvm/debian/ )

-------------------------------------------------------------------------------

 - Upload Webmin RPM
	scp /usr/local/webadmin/rpm/webmin-$ver-1.noarch.rpm virtualmin@virtualmin.com:domains/vm2.virtualmin.com/public_html/kvm/universal/
	ssh virtualmin@virtualmin.com "cd domains/vm2.virtualmin.com/public_html/kvm/universal ; createrepo -s sha ."

 - Upload Webmin tar.gz
	scp /usr/local/webadmin/tarballs/webmin-$ver.tar.gz virtualmin@virtualmin.com:domains/vm2.virtualmin.com/public_html/kvm/wbm/
	ssh virtualmin@virtualmin.com "cd domains/vm2.virtualmin.com/public_html/kvm/wbm ; rm webmin-current.tar.gz ; ln -s webmin-$ver.tar.gz webmin-current.tar.gz ; echo $ver > webmin-version"

 - Upload Webmin DEB
	cp /usr/local/webadmin/deb/webmin_${ver}_all.deb /usr/local/download/deb/cloudmin-kvm/binary
	ssh lentor "cd /usr/local/download/deb/cloudmin-kvm ; ./make-repo.sh"
        ( cd /usr/local/download/deb/cloudmin-kvm ; rsync --rsh=ssh -r -v * virtualmin@virtualmin.com:domains/vm2.virtualmin.com/public_html/kvm/debian/ )

-------------------------------------------------------------------------------

 - Upload theme RPM
        scp /usr/src/redhat/RPMS/noarch/wbt-virtual-server-theme-$themever-1.noarch.rpm virtualmin@virtualmin.com:domains/vm2.virtualmin.com/public_html/kvm/universal/
        ssh virtualmin@virtualmin.com "cd domains/vm2.virtualmin.com/public_html/kvm/universal ; createrepo -s sha ."

 - Upload theme tar.gz
        scp /usr/local/webadmin/virtualmin/virtual-server-theme-$themever.wbt.gz* virtualmin@virtualmin.com:domains/vm2.virtualmin.com/public_html/kvm/wbm/
        ssh virtualmin@virtualmin.com
        vi domains/vm2.virtualmin.com/public_html/kvm/wbm/updates.txt

 - Upload theme DEB
        ssh lentor "cp /tmp/webmin-virtual-server-theme_${themever}_all.deb /usr/local/download/deb/cloudmin-kvm/binary"
        ssh lentor "cd /usr/local/download/deb/cloudmin-kvm ; ./make-repo.sh"
        ( cd /usr/local/download/deb/cloudmin-kvm ; rsync --rsh=ssh -r -v * virtualmin@virtualmin.com:domains/vm2.virtualmin.com/public_html/kvm/debian/ )

